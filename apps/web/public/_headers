# Cloudflare Pages response headers. Every matching rule applies, in order.

# HTML (and the SPA fallback for deep links): always revalidate, so a new deploy shows up on the next load.
/*
  Cache-Control: no-cache

# Vite's content-hashed build output never changes under the same name. Drop the rule above first,
# or Pages would join the two values into one conflicting header.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# A quick split's share link is private to the people it was sent to: keep it out of search engines.
# The page sets <meta name="robots" content="noindex"> too.
/s/*
  X-Robots-Tag: noindex
